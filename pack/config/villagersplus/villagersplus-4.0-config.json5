{
  //Max amount of experience storable in the enchanted basin. (Default: 500)
  "max_exp_amount": 500,
  //Amount of experience taken or given to the enchanted basin per interaction. (Default: 50)
  "exp_amount": 50,
  //Enable explosion potential of the alchemist workstation. (Default: true)
  "can_explode": true,
  //Chance of the alchemist workstation NOT exploding (1 in ?). Must be greater than 0! (Default: 3)
  "explosion_chance": 3,
  //Weight of the house in the village structure pool. Higher values increase the chance of generating.
  "plains_alchemist_weight": 10,
  "plains_occultist_weight": 10,
  "plains_horticulturist_weight": 7,
  "plains_oceanographer_weight": 15,
  "plains_miner_weight": 25,
  //Weight of the house in a village. Higher values increase the chance of generating.
  "taiga_alchemist_weight": 10,
  "taiga_occultist_weight": 10,
  "taiga_horticulturist_weight": 7,
  "taiga_oceanographer_weight": 15,
  "taiga_miner_weight": 25,
  //Weight of the house in a village. Higher values increase the chance of generating.
  "savanna_alchemist_weight": 10,
  "savanna_occultist_weight": 10,
  "savanna_horticulturist_weight": 7,
  "savanna_oceanographer_weight": 15,
  "savanna_miner_weight": 25,
  //Weight of the house in a village. Higher values increase the chance of generating.
  "snowy_alchemist_weight": 10,
  "snowy_occultist_weight": 10,
  "snowy_horticulturist_weight": 7,
  "snowy_oceanographer_weight": 15,
  //Weight of the house in a village. Higher values increase the chance of generating.
  "desert_alchemist_weight": 10,
  "desert_occultist_weight": 10,
  "desert_horticulturist_weight": 7,
  "desert_oceanographer_weight": 15,
  //When true, the mineshaft below the miner's house ends in a real vanilla mineshaft instead of just dead-ending. (Default: true)
  "mineshaft_connects_to_vanilla_mineshaft": true,
  //Scales the ore grinder's base yields. 1.0 keeps the defaults: iron/gold/coal/diamond/emerald/quartz ore -> 2, copper -> 3, lapis/redstone -> 8. Examples: 0.5 halves everything (iron ore -> 1 raw iron), 2.0 doubles it (iron ore -> 4 raw iron). Minimum result is always 1 item. (Default: 1.0)
  "ore_grinder_output_multiplier": 1.0,
  //Whether Fortune on the inserted pickaxe additionally increases the ore grinder's yield. (Default: true)
  "ore_grinder_fortune_enabled": true,
  //Durability the inserted pickaxe loses per ground ore. Unbreaking is honored per durability point. (Default: 3)
  "ore_grinder_pickaxe_damage": 3,
  //Two flower positions in the flower tub (absolute X/Z offset from the block, applied per plant).
  "first_flower_in_two_X": 0.15,
  "first_flower_in_two_Z": 0.15,
  "second_flower_in_two_X": -0.15,
  "second_flower_in_two_Z": -0.2,
  //Three flower positions in the flower tub (absolute X/Z offset from the block, applied per plant).
  "first_flower_in_three_X": 0.15,
  "first_flower_in_three_Z": 0.0,
  "second_flower_in_three_X": -0.15,
  "second_flower_in_three_Z": -0.15,
  "third_flower_in_three_X": -0.2,
  "third_flower_in_three_Z": 0.15,
  //Four flower positions in the flower tub (absolute X/Z offset from the block, applied per plant).
  "first_flower_in_four_X": 0.15,
  "first_flower_in_four_Z": 0.15,
  "second_flower_in_four_X": 0.15,
  "second_flower_in_four_Z": -0.2,
  "third_flower_in_four_X": -0.15,
  "third_flower_in_four_Z": -0.2,
  "forth_flower_in_four_X": -0.2,
  "forth_flower_in_four_Z": 0.17
}
